# AArch64 multi-platform
# Maintainer: Kevin Mihelich <kevin@archlinuxarm.org>

buildarch=8

pkgbase=linux-yoga
_srcname=linux-7.3
_kernelname=${pkgbase#linux}
_desc="AArch64 multi-platform"
pkgver=7.3
pkgrel=4
arch=('aarch64')
url="http://www.kernel.org/"
license=('GPL2')
makedepends=('xmlto' 'docbook-xsl' 'kmod' 'inetutils' 'bc' 'git' 'uboot-tools' 'dtc' 'ccache')
options=('!strip')
source=("https://cdn.kernel.org/pub/linux/kernel/v7.x/${_srcname}.tar.xz"
        'arch.config'
        'yoga.config'
        'trim.config'
        'linux.preset'
        '60-linux.hook'
        '90-linux.hook'
        '0001-arm64-dts-qcom-sdm850-lenovo-yoga-c630-enable-dp.patch'
        '0002-efi-efivars-handle-read-only-variable-writes.patch'
        '0003-firmware-qcom-pass-qseecom-quirks.patch'
        '0004-firmware-qcom-uefisecapp-read-only-variables.patch'
        '0005-firmware-qcom-enable-yoga-c630-qseecom.patch'
        '0006-arm64-dts-qcom-yoga-c630-uefi-rtc-offset.patch')
sha256sums=('87363c24f10e06321eb362765521094e94471f6bff8bce2d6b3e40f39f004953'
