# Extra configuration that doesn't fall under SOC

# Bluetooth
CONFIG_BT_BNEP=m
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_BT_BNEP_PROTO_FILTER=y
CONFIG_BT_LE=y
CONFIG_BT_LE_L2CAP_ECRED=y
CONFIG_BT_RFCOMM=m
CONFIG_BT_RFCOMM_TTY=y

# Crypto
CONFIG_CRYPTO_LZ4=m
CONFIG_FS_ENCRYPTION=y
CONFIG_FS_ENCRYPTION_INLINE_CRYPT=y
CONFIG_CRYPTO_USER_API_AEAD=y

# Networking
# westwood is more efficient for wireless connections
# than cubic
CONFIG_DEFAULT_WESTWOOD=y
CONFIG_NETLINK_DIAG=m
CONFIG_PACKET_DIAG=y

# DRM
CONFIG_DRM_GUD=m

# Ramdisk
CONFIG_BLK_DEV_RAM_COUNT=16
CONFIG_BLK_DEV_RAM_SIZE=8192

# EFI
CONFIG_EFI_SBAT_FILE=""
CONFIG_EFI_ZBOOT=y

# UTF8
CONFIG_FAT_DEFAULT_UTF8=y

# Inputs
CONFIG_INPUT_JOYDEV=m

# Compression
CONFIG_KERNEL_GZIP=y
CONFIG_MODULE_COMPRESS=y
CONFIG_MODULE_COMPRESS_ALL=y
CONFIG_MODULE_COMPRESS_ZSTD=y
CONFIG_MODULE_DECOMPRESS=y

# Multi-Gen LRU
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
CONFIG_LRU_GEN_WALKS_MMU=y

# Native Language Support
CONFIG_NLS_ASCII=y
CONFIG_NLS_DEFAULT="utf8"

# SCSI

# Sound
CONFIG_SND_HWDEP=m
CONFIG_SND_USB_AUDIO_USE_MEDIA_CONTROLLER=y

# TCP
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BIC=m
CONFIG_TCP_CONG_HTCP=m
CONFIG_TCP_CONG_WESTWOOD=y

# UNIX Sockets
CONFIG_UNIX_DIAG=y

# USB
CONFIG_USB_CONFIGFS_F_HID=y
CONFIG_TYPEC=y

# Serial
CONFIG_U_SERIAL_CONSOLE=y

# Pstore
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y

# Debugging
CONFIG_ATH10K_DEBUG=y
CONFIG_ATH10K_DEBUGFS=y
CONFIG_ATH10K_SPECTRAL=y

# ZRAM

# Misc useful things
CONFIG_HZ_1000=y

# libcamera
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_DMABUF_HEAPS_CMA=y
CONFIG_DMABUF_HEAPS=y
CONFIG_DMA_CMA=y
CONFIG_CMA=y
CONFIG_CMA_SIZE_MBYTES=256

# Debugging stuff
CONFIG_STACKTRACE=y

# Power management
CONFIG_PM_AUTOSLEEP=y
CONFIG_PM_WAKELOCKS=y

# Yoga-specific overrides
# Lenovo Yoga C630 hardware delta beyond upstream sdm845 fragments
CONFIG_CROS_EC_TYPEC=m
CONFIG_CROS_TYPEC_SWITCH=m
CONFIG_UCSI_LENOVO_YOGA_C630=m
CONFIG_GPIO_SHARED_PROXY=m
CONFIG_HID_LENOVO=m
CONFIG_QCOM_WDT=m
CONFIG_REGULATOR_QCOM_REFGEN=m
CONFIG_SPI_QCOM_GENI=m
CONFIG_EXTCON_USBC_CROS_EC=y
CONFIG_EXTCON_USB_GPIO=y

# Read the Yoga C630 firmware RTC offset through read-only QSEECOM UEFI vars.
CONFIG_EFI=y
CONFIG_EFIVAR_FS=y
CONFIG_QCOM_QSEECOM=y
CONFIG_QCOM_QSEECOM_UEFISECAPP=y
CONFIG_RTC_DRV_PM8XXX=m
