# Contributor: Rigo Orozco-Diaz

pkgname=alsa-ucm-conf-yoga-c630
pkgver=1.2.16.1
pkgrel=3
pkgdesc="ALSA UCM and WirePlumber audio fixes for the Lenovo Yoga C630"
arch=('aarch64')
url="https://github.com/rigoorozco/yoga-alarm"
license=('BSD-3-Clause')
depends=('wireplumber')
provides=("alsa-ucm-conf=${pkgver}")
conflicts=('alsa-ucm-conf')
replaces=('alsa-ucm-conf')
backup=('etc/wireplumber/wireplumber.conf.d/51-yoga-c630-audio.conf')
source=(
  "https://www.alsa-project.org/files/pub/lib/alsa-ucm-conf-${pkgver}.tar.bz2"
  'HiFi-MM1.conf'
  '51-yoga-c630-audio.conf'
)
sha256sums=(
  'cf3d1c07e089a83c4ece2c20f05dd6a8aab7fcd108768c38811386880575492b'
  'c423056d829cd4883f6275d68b0b0856922a0b5e587d25ef07ad50f0bb7c0617'
  'a1d8ea9439b13c38ddc2cab767bb9f5144f8be38901d0d3e11b347a29e371cb6'
)

package() {
  cd "alsa-ucm-conf-${pkgver}"

  install -d "${pkgdir}/usr/share/alsa"
  cp -r --no-preserve=ownership ucm2 "${pkgdir}/usr/share/alsa/"

  # Replace the upstream SDM845 profile with the known-good Yoga C630 routing.
  install -Dm644 "${srcdir}/HiFi-MM1.conf" \
    "${pkgdir}/usr/share/alsa/ucm2/Qualcomm/sdm845/HiFi-MM1.conf"

  install -Dm644 README.md \
    "${pkgdir}/usr/share/doc/alsa-ucm-conf/README.md"
  ln -s ../../alsa/ucm2/README.md \
    "${pkgdir}/usr/share/doc/alsa-ucm-conf/ucm2"
  install -Dm644 LICENSE \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"

  install -Dm644 "${srcdir}/51-yoga-c630-audio.conf" \
    "${pkgdir}/etc/wireplumber/wireplumber.conf.d/51-yoga-c630-audio.conf"
}
