package() {
  local fwdir="$pkgdir/usr/lib/firmware"

  # Lenovo Yoga (SDM850) platform firmware
  install -d "$fwdir/qcom/sdm850/LENOVO/81JL"
  install -m 644 "$srcdir/adspr.jsn"                "$fwdir/qcom/sdm850/LENOVO/81JL/adspr.jsn"c
  install -m 644 "$srcdir/adspua.jsn"               "$fwdir/qcom/sdm850/LENOVO/81JL/adspua.jsn"c
  install -m 644 "$srcdir/cdspr.jsn"                "$fwdir/qcom/sdm850/LENOVO/81JL/cdspr.jsn"c
  install -m 644 "$srcdir/modemuw.jsn"              "$fwdir/qcom/sdm850/LENOVO/81JL/modemuw.jsn"c
  install -m 644 "$srcdir/qcadsp850.mbn"            "$fwdir/qcom/sdm850/LENOVO/81JL/qcadsp850.mbn"c
  install -m 644 "$srcdir/qccdsp850.mbn"            "$fwdir/qcom/sdm850/LENOVO/81JL/qccdsp850.mbn"c
  install -m 644 "$srcdir/qcdsp1v2850.mbn"          "$fwdir/qcom/sdm850/LENOVO/81JL/qcdsp1v2850.mbn"c
  install -m 644 "$srcdir/qcdsp1v2850_nm.mbn"       "$fwdir/qcom/sdm850/LENOVO/81JL/qcdsp1v2850_nm.mbn"c
  install -m 644 "$srcdir/qcdsp2850.mbn"            "$fwdir/qcom/sdm850/LENOVO/81JL/qcdsp2850.mbn"c
  install -m 644 "$srcdir/qcdsp2850_nm.mbn"         "$fwdir/qcom/sdm850/LENOVO/81JL/qcdsp2850_nm.mbn"c
  install -m 644 "$srcdir/qcdxkmsuc850.mbn"         "$fwdir/qcom/sdm850/LENOVO/81JL/qcdxkmsuc850.mbn"c
  install -m 644 "$srcdir/qcslpi850.mbn"            "$fwdir/qcom/sdm850/LENOVO/81JL/qcslpi850.mbn"c
  install -m 644 "$srcdir/qcslpi850_cls.mbn"        "$fwdir/qcom/sdm850/LENOVO/81JL/qcslpi850_cls.mbn"c
  install -m 644 "$srcdir/qcvss850.mbn"             "$fwdir/qcom/sdm850/LENOVO/81JL/qcvss850.mbn"c
  install -m 644 "$srcdir/wlanmdsp.mbn"             "$fwdir/qcom/sdm850/LENOVO/81JL/wlanmdsp.mbn"c

  # Adreno A630 firmware
  install -d "$fwdir/qcom"
  install -m 644 "$srcdir/a630_sqe.fw"              "$fwdir/qcom/a630_sqe.fw"
  install -m 644 "$srcdir/a630_gmu.bin"             "$fwdir/qcom/a630_gmu.bin"
}
